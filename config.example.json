{
  "PollSeconds": 2,
  "StartDebounceSeconds": 2,
  "StopDebounceSeconds": 5,

  "WatchedApps": [
    "slack\\.exe$",
    "chrome\\.exe$",
    "msedge\\.exe$",
    "Teams\\.exe$",
    "ms-teams\\.exe$",
    "^MSTeams",
    "^MicrosoftTeams",
    "zoom\\.exe$"

    "is sharing your screen",
    "Stop sharing",
    "Screen sharing toolbar",
    "You're presenting",
    "You are presenting"
  ],

  "OnShareStart": "",
  "OnShareStop": "",

  "LogLevel": "INFO",
  "MaxLogSizeKB": 512
}
